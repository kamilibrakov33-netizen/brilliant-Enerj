# Правки сценария Make «Brilliant Energy — бот» (id 7410088): цены как на сайте и юридически безопасные формулировки.
# Использование: jq -f update-bot.jq backup.json > new.json  (backup.json = ответ scenarios_get)
def rep($a; $b): split($a) | join($b);
def fix:
    rep("2 990"; "4 900")
  | rep("9 900"; "14 900")
  | rep("электротовары и обучение"; "электротовары и курс по электромонтажу")
  | rep("урок → короткий экзамен → следующий урок"; "урок → короткие проверочные вопросы → следующий урок")
  | rep("урок, короткий экзамен, следующий урок"; "урок, короткие проверочные вопросы, следующий урок")
  | rep("Учитесь с телефона в своём темпе"; "Проходите курс с телефона в своём темпе")
  | rep("49 уроков с экзаменом после каждого"; "49 уроков с проверочными вопросами после каждого")
  | rep("Учитесь сами — ваши работы мы не проверяем."; "Проходите сами — ваши работы мы не проверяем.")
  | rep("• Итоговый экзамен"; "• Итоговая проверка знаний")
  | rep("рядом с наставником"; "рядом с практическим консультантом")
  | rep("Выезд на объект с наставником"; "Выезд на объект с консультантом")
  | rep("Помощь с подготовкой к группе по электробезопасности"; "Рекомендации по подготовке к группе по электробезопасности (группу присваивают другие организации)")
  | rep("«Старт» — только экзамены"; "«Старт» — только проверочные вопросы")
  | rep("Сертификат собственного образца, допуска к работам не даёт."; "Подтверждение прохождения курса — документ собственного образца, не документ об образовании и не допуск к работам.")
  | rep("12 модулей, 49 уроков. Уроки и короткие экзамены в Telegram"; "14 модулей, 49 уроков. Уроки и проверочные вопросы в Telegram")
  | rep("▶️ Начать обучение"; "▶️ Начать курс")
  | rep("Ученик «Мастера» прислал задание"; "Участник тарифа «Мастер» прислал задание")
  | rep("✅ Экзамен сдан!"; "✅ Верно!")
  | rep("📝 Экзамен по уроку:"; "📝 Проверочные вопросы по уроку:")
  | rep("Вы сдали все 49 экзаменов курса"; "Вы ответили на проверочные вопросы всех 49 уроков курса")
  | rep("Ученик "; "Участник ")
  | rep("сдал все 49 экзаменов курса"; "прошёл все 49 уроков курса")
  | rep("Задание зачтено, ученику отправлено"; "Задание зачтено, участнику отправлено")
  | rep("Тест экзаменов. Нажмите"; "Тест проверочных вопросов. Нажмите");
.blueprint.flow |= walk(if type == "string" then fix else . end)
